# Database
DB_URL=jdbc:postgresql://localhost:5432/codequality
DB_USERNAME=codequality
DB_PASSWORD=codequality

# JWT (must be >= 256 bits / 32+ chars)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits-long-value
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# GitHub integration (personal access token with repo:read)
GITHUB_TOKEN=

# AI provider: openai | azure
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Azure only:
AI_AZURE_DEPLOYMENT=
AI_AZURE_API_VERSION=2024-06-01
